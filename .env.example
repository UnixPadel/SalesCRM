# Kopyalayıp .env adıyla kaydedin (.env git'e girmez).

# Giriş: şirket kullanıcı tablosu KullaniciBilgileri (Clever Cloud MySQL).
# Panelden MYSQL_ADDON_URI'yi yapıştırın ya da parçaları birleştirin:
#   mysql://<User>:<Password>@<Server>:<Port>/<Database>
AUTH_DB_URL=mysql://kullanici:sifre@b5l1shhnklxmq4ogmpjc-mysql.services.clever-cloud.com:21446/b5l1shhnklxmq4ogmpjc
AUTH_DB_TABLE=KullaniciBilgileri
# Sütunlar (varsayılanlar tabloya göre ayarlı; gerekirse değiştirin):
# AUTH_DB_USER_COL=KullaniciAdi   AUTH_DB_EMAIL_COL=Email   AUTH_DB_PASS_COL=Sifre
# AUTH_DB_FIRSTNAME_COL=Ad        AUTH_DB_LASTNAME_COL=Soyad
# AUTH_DB_ROLE_COL=YetkiTuru      AUTH_DB_ADMIN_ROLES=Yonetici   AUTH_DB_SALES_ROLES=Yonetici,Temsilci
# AUTH_DB_ACTIVE_COL=Durum        AUTH_DB_ACTIVE_VALUE=Aktif
# AUTH_DB_SSL=1

# E-posta okuma (IMAP) şimdilik kapalı; açmak için 1 yapın.
MAIL_ENABLED=0
