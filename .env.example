# Kopyalayıp .env adıyla kaydedin (.env git'e girmez). Gerçek değerler yalnız .env ve hosting
# ortam değişkenlerinde bulunur; bu dosyada yer tutucu dışında hiçbir şey olmaz (ADR-0004).

# Giriş: şirket kullanıcı tablosu (MySQL). Panelden bağlantı adresini yapıştırın.
# Biçim: şema "mysql", ardından kullanıcı, iki nokta, şifre, @, sunucu, iki nokta, port, / veritabanı.
AUTH_DB_URL=
AUTH_DB_TABLE=KullaniciBilgileri
# Sütunlar (varsayılanlar tabloya göre ayarlı; gerekirse değiştirin):
# AUTH_DB_USER_COL=KullaniciAdi   AUTH_DB_EMAIL_COL=Email   AUTH_DB_PASS_COL=Sifre
# AUTH_DB_FIRSTNAME_COL=Ad        AUTH_DB_LASTNAME_COL=Soyad
# AUTH_DB_ROLE_COL=YetkiTuru      AUTH_DB_ADMIN_ROLES=Yonetici   AUTH_DB_SALES_ROLES=Yonetici,Temsilci
# AUTH_DB_ACTIVE_COL=Durum        AUTH_DB_ACTIVE_VALUE=Aktif
# AUTH_DB_SSL=1

# E-posta okuma (IMAP) şimdilik kapalı; açmak için 1 yapın.
MAIL_ENABLED=0
# IMAP_HOST=mail.example.com
# IMAP_PORT=993
# MAIL_DOMAIN=example.com

# Sunucu
# API_PORT=8787
# CRM_DATA=server/data/crm.json   (yalnız db:migrate-legacy girdisi: eski JSON dışa aktarımı)
# PUBLIC_BASE_URL=            (e-posta bildirimlerindeki bağlantı kökü, ör. https://crm.example.com)

# --- Satış pipeline'ı (Faz 1) ---
# DATABASE_URL=            (şema "postgres", aynı biçim; boşsa yerel PGlite)
# PGLITE_DIR=server/data/pglite
# UNDO_WINDOW_MINUTES=10
# Pano toplamları için para birimi → EUR çarpanları (Faz 6b). Boşsa varsayılan: USD 0.92, GBP 1.17, TRY 0.027
# EUR_RATES={"USD":0.92,"GBP":1.17,"TRY":0.027}
# Ürün tercihlerini (kort adetleri, çatı ölçüsü) lead'in sorumlusu satışçı da girer (Faz 7g, açık soru 1: evet).
# Yalnız yöneticiye bırakmak için: REPS_EDIT_PRODUCTS=0
# Giden olaylar hangi platformlara yazılır (virgülle). Boşsa outbox satırı açılmaz. Faz 4: meta; Faz 5: meta,google
# ENABLED_PROVIDERS=meta

# --- Gelen lead akışı (Faz 2) ---
# Inbox payload şifreleme anahtarı: `npm run secrets:key` ile üretin. Staging ve canlıda zorunlu.
INBOX_ENCRYPTION_KEY=
# INTAKE_POLL_SECONDS=5
# INTAKE_RETRY_MINUTES=1,5,30,120,720
# INTAKE_DEFAULT_COUNTRY=TR
# INBOX_RETENTION_DAYS=30
# BACKFILL_INTERVAL_MINUTES=60
# BACKFILL_LOOKBACK_HOURS=2

# Meta Lead Ads (docs/runbooks/meta-lead-ads.md)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_SYSTEM_USER_TOKEN=
# META_GRAPH_API_VERSION=v26.0
# META_PAGE_ID=
# META_FORM_IDS=           (virgülle; integration_settings doluysa o kazanır)

# Google Ads lead formu (docs/runbooks/google-lead-form.md)
GOOGLE_LEAD_FORM_KEY=

# --- Meta geri bildirimi, Conversions API (Faz 4, docs/runbooks/meta-capi.md) ---
# Veri seti (dataset) kimliği: MarcaDM Events Manager'dan iletir. integration_settings meta/dataset_id doluysa o kazanır.
META_DATASET_ID=
# Boşsa META_SYSTEM_USER_TOKEN kullanılır (aynı sistem kullanıcısı, ads_management yetkisi).
META_CAPI_TOKEN=
# Yalnız staging: Events Manager → Test Olayları kodu. Canlıda BOŞ bırakın.
# META_TEST_EVENT_CODE=
# OUTBOX_DISPATCH_SECONDS=60
# OUTBOX_RETRY_MINUTES=1,5,30,120,720
# OUTBOX_BATCH_SIZE=100
# CONSENT_REQUIRED_TYPE=kvkk
# Günlük dead-letter raporu alıcıları (virgülle); boşsa yalnız loglanır.
# OUTBOX_REPORT_TO=

# --- Google geri bildirimi, Data Manager API (Faz 5, docs/runbooks/google-data-manager.md) ---
# Servis hesabı anahtarı: Cloud Console'dan indirilen JSON (tek satır) ya da base64 hâli. Boşsa Google göndericisi kurulmaz.
GOOGLE_DM_SERVICE_ACCOUNT_KEY=
# Google Ads müşteri kimliği (10 hane); integration_settings google/customer_id doluysa o kazanır.
GOOGLE_ADS_CUSTOMER_ID=
# Yönetici (MCC) hesabı üzerinden erişiliyorsa; yoksa boş.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Yalnız staging: istekler doğrulanır, işlenmez. Canlıda BOŞ bırakın.
# GOOGLE_DM_VALIDATE_ONLY=
# GOOGLE_CLICK_WINDOW_DAYS=90
# GOOGLE_USER_DATA_WINDOW_DAYS=63
# GOOGLE_EVENT_SOURCE=WEB
# GOOGLE_EVENT_TIMEZONE=Europe/Istanbul
# GOOGLE_SEND_SOURCES=google_form,web_form

# Bildirim e-postası (SMTP). SMTP_HOST boşsa e-posta gönderilmez, yalnız loglanır.
# SMTP_HOST=mail.example.com
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_FROM=crm@example.com
# SMTP_USER=
# SMTP_PASSWORD=

# --- Web sitesi formu (Faz 3, docs/runbooks/web-form.md) ---
# Site sunucusu (integrations/web-form-relay) ile paylaşılan imza anahtarı: `npm run secrets:key`.
WEB_FORM_HMAC_KEY=
