{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "crm",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "crm-test-login",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/dev.mjs", "--dev-login=test1234"],
      "port": 5173
    },
    {
      "name": "crm-webhook-smoke",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/dev.mjs",
        "--dev-login=test1234",
        "--set=GOOGLE_LEAD_FORM_KEY=smoke-google-key",
        "--set=META_APP_SECRET=smoke-meta-secret",
        "--set=META_VERIFY_TOKEN=smoke-verify-token",
        "--set=INBOX_ENCRYPTION_KEY=c21va2Utc21va2Utc21va2Utc21va2Utc21va2UtMDE=",
        "--set=WEB_FORM_HMAC_KEY=smoke-web-form-secret",
        "--set=ENABLED_PROVIDERS=meta",
        "--set=OUTBOX_REPORT_TO=admin@example.com",
        "--set=PUBLIC_BASE_URL=http://localhost:5173"
      ],
      "port": 5173
    },
    {
      "name": "web-form-relay-smoke",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "integrations/web-form-relay/relay.mjs",
        "--set=WEB_FORM_HMAC_KEY=smoke-web-form-secret",
        "--set=CRM_FORM_URL=http://localhost:8787/forms/web",
        "--set=RELAY_RETRY_SECONDS=10",
        "--set=RELAY_FORM_ID=contact",
        "--set=RELAY_CONSENT_TEXT_VERSION=2026-01"
      ],
      "port": 8790
    }
  ]
}
